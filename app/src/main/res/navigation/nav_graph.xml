<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.codvedx_t_2.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_transactions"
        android:name="com.example.codvedx_t_2.ui.transaction.TransactionsListFragment"
        android:label="Transactions"
        tools:layout="@layout/fragment_transactions_list" />

    <fragment
        android:id="@+id/navigation_analytics"
        android:name="com.example.codvedx_t_2.ui.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/navigation_budget"
        android:name="com.example.codvedx_t_2.ui.budget.BudgetFragment"
        android:label="Budget"
        tools:layout="@layout/fragment_budget" />

    <fragment
        android:id="@+id/navigation_more"
        android:name="com.example.codvedx_t_2.ui.more.MoreFragment"
        android:label="More"
        tools:layout="@layout/fragment_more" />

    <fragment
        android:id="@+id/navigation_goals"
        android:name="com.example.codvedx_t_2.ui.goals.GoalsFragment"
        android:label="Financial Goals"
        tools:layout="@layout/fragment_goals" />

    <fragment
        android:id="@+id/navigation_accounts"
        android:name="com.example.codvedx_t_2.ui.accounts.AccountsFragment"
        android:label="Accounts &amp; Wallets"
        tools:layout="@layout/fragment_accounts" />

    <fragment
        android:id="@+id/navigation_subscriptions"
        android:name="com.example.codvedx_t_2.ui.subscriptions.SubscriptionsFragment"
        android:label="Subscriptions"
        tools:layout="@layout/fragment_subscriptions" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.codvedx_t_2.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
